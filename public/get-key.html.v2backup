<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>🎁 Lấy Key Miễn Phí</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #e2e8f0;
    min-height: 100vh;
    padding: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1.6;
}
.container { max-width: 600px; width: 100%; }
.card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
}
.header { text-align: center; margin-bottom: 24px; }
.header h1 { color: #38bdf8; font-size: 26px; margin-bottom: 8px; }
.header p { color: #94a3b8; font-size: 14px; }

/* Tool selection */
.tool-select {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 14px;
}
.tool-btn {
    background: #0f172a;
    border: 2px solid #334155;
    border-radius: 12px;
    padding: 20px 14px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
}
.tool-btn:hover { border-color: #38bdf8; transform: translateY(-2px); }
.tool-btn.selected { border-color: #38bdf8; background: #0c4a6e; }
.tool-btn.selected.magic { border-color: #a855f7; background: #581c87; }
.tool-btn .icon { font-size: 32px; margin-bottom: 6px; }
.tool-btn .name { font-size: 15px; font-weight: bold; color: #e2e8f0; margin-bottom: 4px; }
.tool-btn .desc { font-size: 11px; color: #94a3b8; }

/* Steps */
.step {
    background: #0f172a;
    border: 1px solid #334155;
    border-left: 4px solid #0ea5e9;
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 14px;
}
.step.active { border-left-color: #10b981; box-shadow: 0 0 20px rgba(16, 185, 129, 0.15); }
.step.magic-step { border-left-color: #a855f7; }
.step-title { color: #38bdf8; font-size: 15px; font-weight: bold; margin-bottom: 10px; }
.step-title .num {
    display: inline-block;
    background: #0ea5e9; color: white;
    width: 24px; height: 24px; line-height: 24px;
    text-align: center; border-radius: 50%;
    margin-right: 8px; font-size: 13px;
}
.step.active .step-title .num { background: #10b981; }
.step.magic-step .step-title .num { background: #a855f7; }
.step.magic-step .step-title { color: #c084fc; }

button.action {
    background: linear-gradient(135deg, #0ea5e9, #0284c7);
    color: white; border: none; border-radius: 10px;
    padding: 14px 20px; font-size: 16px; font-weight: bold;
    cursor: pointer; width: 100%; transition: all 0.2s;
    font-family: inherit;
}
button.action:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(14, 165, 233, 0.4); }
button.action:disabled { background: #334155; cursor: not-allowed; opacity: 0.6; }
button.action.magic { background: linear-gradient(135deg, #a855f7, #7e22ce); }
button.action.magic:hover:not(:disabled) { box-shadow: 0 10px 30px rgba(168, 85, 247, 0.4); }
button.action.success { background: linear-gradient(135deg, #10b981, #059669); }

input {
    background: #0f172a;
    border: 2px solid #475569;
    border-radius: 10px;
    padding: 14px 16px;
    font-size: 18px; color: #e2e8f0;
    width: 100%; text-transform: uppercase;
    text-align: center; letter-spacing: 3px;
    font-weight: bold; font-family: 'Courier New', monospace;
    transition: all 0.2s;
}
input:focus { outline: none; border-color: #38bdf8; box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.1); }

.msg {
    padding: 12px 14px; border-radius: 8px;
    margin-top: 10px; font-size: 14px;
    display: none;
}
.msg.show { display: block; }
.msg.ok { background: #065f46; color: #6ee7b7; border: 1px solid #10b981; }
.msg.err { background: #7f1d1d; color: #fca5a5; border: 1px solid #ef4444; }
.msg.info { background: #1e3a8a; color: #93c5fd; border: 1px solid #3b82f6; }

.hidden { display: none !important; }

.key-box {
    background: #0f172a;
    border: 2px dashed #10b981;
    border-radius: 12px;
    padding: 18px; text-align: center;
    margin: 12px 0;
}
.key-box.magic { border-color: #a855f7; }
.key-box .label {
    color: #94a3b8; font-size: 12px; margin-bottom: 8px;
    text-transform: uppercase; letter-spacing: 1px;
}
.key-box .key {
    color: #fbbf24; font-size: 16px;
    font-family: 'Courier New', monospace; font-weight: bold;
    word-break: break-all; margin: 8px 0; padding: 10px;
    background: #020617; border-radius: 8px;
}
.key-info {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 8px; margin-top: 12px; font-size: 13px;
}
.key-info > div {
    background: #0f172a; padding: 8px 10px; border-radius: 6px;
}
.key-info .label { color: #64748b; font-size: 11px; }
.key-info .value { color: #38bdf8; font-weight: bold; }

.copy-btn {
    background: #10b981;
    margin-top: 10px; padding: 10px; font-size: 14px;
    border: none; border-radius: 8px; color: white;
    font-weight: bold; cursor: pointer; width: 100%;
    font-family: inherit;
}
.copy-btn:hover { background: #059669; }

.tips {
    background: #1e3a8a;
    border-left: 3px solid #3b82f6;
    border-radius: 8px;
    padding: 12px; font-size: 13px;
    color: #93c5fd; margin-top: 12px;
}
.tips.magic { background: #581c87; border-color: #a855f7; color: #d8b4fe; }
.tips.success { background: #065f46; border-color: #10b981; color: #6ee7b7; }

.loading {
    text-align: center; padding: 20px; color: #38bdf8;
}
.loading::after {
    content: '...'; animation: dots 1.5s infinite;
}
@keyframes dots {
    0%, 20% { content: '.'; }
    40% { content: '..'; }
    60%, 100% { content: '...'; }
}

.footer {
    text-align: center; color: #475569;
    font-size: 11px; margin-top: 20px;
}

.current-tool {
    display: inline-block;
    background: #0c4a6e; color: #38bdf8;
    padding: 4px 12px; border-radius: 20px;
    font-size: 12px; font-weight: bold;
    margin-bottom: 12px;
}
.current-tool.magic { background: #581c87; color: #d8b4fe; }
</style>
</head>
<body>

<div class="container">
    <div class="card">
        <div class="header">
            <h1>🎁 LẤY KEY MIỄN PHÍ</h1>
            <p>Vượt link để nhận key sử dụng tool</p>
        </div>

        <!-- CHỌN TOOL -->
        <div id="toolSelectBox">
            <div class="tool-select">
                <div class="tool-btn" id="btnMoslot" onclick="selectTool('moslot')">
                    <div class="icon">🎮</div>
                    <div class="name">MoSlot</div>
                    <div class="desc">Mở slot hero</div>
                </div>
                <div class="tool-btn" id="btnMagic" onclick="selectTool('magic')">
                    <div class="icon">✨</div>
                    <div class="name">Magic</div>
                    <div class="desc">Hack đá tím</div>
                </div>
            </div>
        </div>

        <!-- BƯỚC 1: VƯỢT LINK -->
        <div id="step1" class="step hidden">
            <div class="step-title">
                <span class="num">1</span>Vượt link nhận mã xác nhận
            </div>
            <div id="linkBox">
                <div class="loading">Đang tải link</div>
            </div>
            <div id="linkActions" class="hidden" style="margin-top:10px">
                <button id="btnGoLink" class="action" onclick="openLink()">🔗 VƯỢT LINK NGAY</button>
                <div class="tips" id="tip1">
                    💡 Sau khi vượt link, bạn sẽ thấy <strong>mã xác nhận</strong>.
                    Copy mã đó và nhập vào ô bên dưới.
                </div>
            </div>
            <div id="linkMsg" class="msg"></div>
        </div>

        <!-- BƯỚC 2: NHẬP MÃ -->
        <div id="step2" class="step hidden">
            <div class="step-title">
                <span class="num">2</span>Nhập mã xác nhận
            </div>
            <input type="text" id="codeInput" placeholder="NHẬP MÃ" maxlength="20" autocomplete="off">
            <button id="btnVerify" class="action" onclick="verifyCode()" style="margin-top:10px">✅ XÁC NHẬN NHẬN KEY</button>
            <div id="verifyMsg" class="msg"></div>
        </div>

        <!-- BƯỚC 3: NHẬN KEY -->
        <div id="step3" class="step hidden">
            <div class="step-title">
                <span class="num">✓</span>Key của bạn
            </div>
            <div class="key-box" id="keyBox">
                <div class="label">KEY SỬ DỤNG TOOL</div>
                <div class="key" id="keyResult">-</div>
                <button class="copy-btn" onclick="copyKey()">📋 COPY KEY</button>
            </div>
            <div class="key-info">
                <div>
                    <div class="label">Số lượt</div>
                    <div class="value" id="keyMaxUses">-</div>
                </div>
                <div>
                    <div class="label">Còn lại</div>
                    <div class="value" id="keyRemaining">-</div>
                </div>
                <div>
                    <div class="label">Hết hạn</div>
                    <div class="value" id="keyExpiry">-</div>
                </div>
                <div>
                    <div class="label">Hôm nay đã lấy</div>
                    <div class="value" id="keyRateLimit">-</div>
                </div>
            </div>
            <div class="tips success" id="tipSuccess">
                ✅ <strong>LƯU LẠI KEY NÀY!</strong><br>
                Dùng key này khi chạy tool.<br>
                Mỗi key chỉ dùng được trên 1 máy.
            </div>
            <div class="key-info" style="margin-top:12px">
                <div style="grid-column: 1 / -1; text-align:center; color:#64748b; font-size:12px">
                    💡 Muốn lấy thêm key? Nhấn <a href="#" onclick="location.reload()" style="color:#38bdf8">Tải lại trang</a> (tối đa 5 lần/ngày)
                </div>
            </div>
        </div>

        <div class="footer">
            MoSlot + Magic System v7.0 · Cảm ơn bạn đã ủng hộ!
        </div>
    </div>
</div>

<script>
const API = '';
let currentLink = '';
let currentProvider = '';
let currentToolType = '';

// ============================================================
// CHỌN TOOL
// ============================================================
function selectTool(toolType) {
    currentToolType = toolType;

    // Highlight nút được chọn
    document.getElementById('btnMoslot').classList.remove('selected', 'magic');
    document.getElementById('btnMagic').classList.remove('selected', 'magic');

    if (toolType === 'moslot') {
        document.getElementById('btnMoslot').classList.add('selected');
    } else {
        document.getElementById('btnMagic').classList.add('selected', 'magic');
    }

    // Ẩn tool select, hiện bước 1
    document.getElementById('toolSelectBox').classList.add('hidden');

    // Style theo tool
    const steps = document.querySelectorAll('.step');
    steps.forEach(s => {
        s.classList.remove('magic-step', 'active');
    });

    if (toolType === 'magic') {
        document.getElementById('step1').classList.add('magic-step');
        document.getElementById('step2').classList.add('magic-step');
        document.getElementById('btnGoLink').classList.add('magic');
        document.getElementById('btnVerify').classList.add('magic');
        document.getElementById('keyBox').classList.add('magic');
        document.getElementById('tip1').classList.add('magic');
        document.getElementById('tipSuccess').classList.add('magic');
    } else {
        document.getElementById('step1').classList.add('active');
    }

    document.getElementById('step1').classList.remove('hidden');

    // Load link
    loadLink(toolType);
}

// ============================================================
// LOAD LINK
// ============================================================
async function loadLink(toolType) {
    const linkBox = document.getElementById('linkBox');
    const linkActions = document.getElementById('linkActions');

    linkBox.innerHTML = '<div class="loading">Đang tải link</div>';
    linkActions.classList.add('hidden');

    try {
        const res = await fetch(API + '/api/getkey/start', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ toolType: toolType })
        });
        const data = await res.json();

        if (!data.success) {
            linkBox.innerHTML = '<div class="msg show err">' + (data.message || 'Lỗi') + '</div>';
            return;
        }

        currentLink = data.link;
        currentProvider = data.provider || 'Khác';

        const toolLabel = toolType === 'magic' ? '✨ Magic' : '🎮 MoSlot';
        linkBox.innerHTML = `
            <div style="text-align:center; padding:14px 0">
                <div style="color:#94a3b8; font-size:12px; margin-bottom:6px">Tool đã chọn</div>
                <div style="color:${toolType === 'magic' ? '#c084fc' : '#38bdf8'}; font-size:18px; font-weight:bold; margin-bottom:10px">${toolLabel}</div>
                <div style="color:#94a3b8; font-size:12px; margin-bottom:6px">Nhà cung cấp</div>
                <div style="color:#fbbf24; font-size:16px; font-weight:bold">${escapeHtml(currentProvider)}</div>
            </div>
        `;
        linkActions.classList.remove('hidden');
    } catch (e) {
        linkBox.innerHTML = '<div class="msg show err">Không kết nối được server</div>';
    }
}

function openLink() {
    if (!currentLink) return;
    window.open(currentLink, '_blank');
    document.getElementById('step2').classList.remove('hidden');
    if (currentToolType === 'magic') {
        document.getElementById('step2').classList.add('magic-step');
    } else {
        document.getElementById('step2').classList.add('active');
    }
    document.getElementById('step1').classList.remove('active');
    document.getElementById('codeInput').focus();
}

// ============================================================
// VERIFY MÃ
// ============================================================
async function verifyCode() {
    const code = document.getElementById('codeInput').value.trim().toUpperCase();
    const btn = document.getElementById('btnVerify');

    if (!code || code.length < 3) {
        return showMsg('verifyMsg', '❌ Vui lòng nhập mã xác nhận!', 'err');
    }

    btn.disabled = true;
    btn.textContent = '⏳ Đang xác nhận...';
    document.getElementById('verifyMsg').className = 'msg';

    try {
        const res = await fetch(API + '/api/getkey/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code })
        });
        const data = await res.json();

        if (!data.success) {
            showMsg('verifyMsg', '❌ ' + (data.message || 'Lỗi'), 'err');
            btn.disabled = false;
            btn.textContent = '✅ XÁC NHẬN NHẬN KEY';
            return;
        }

        // Thành công!
        document.getElementById('step2').classList.remove('active', 'magic-step');
        document.getElementById('step2').classList.add('hidden');
        document.getElementById('step3').classList.remove('hidden');
        if (data.toolType === 'magic') {
            document.getElementById('step3').classList.add('magic-step');
        } else {
            document.getElementById('step3').classList.add('active');
        }

        document.getElementById('keyResult').textContent = data.key;
        document.getElementById('keyMaxUses').textContent = data.keyInfo.maxUses;
        document.getElementById('keyRemaining').textContent = data.keyInfo.remaining;
        document.getElementById('keyExpiry').textContent = data.keyInfo.expiry;
        document.getElementById('keyRateLimit').textContent = data.rateLimit.todayUsed + '/' + data.rateLimit.maxPerDay;

    } catch (e) {
        showMsg('verifyMsg', '❌ Không kết nối được server', 'err');
        btn.disabled = false;
        btn.textContent = '✅ XÁC NHẬN NHẬN KEY';
    }
}

function copyKey() {
    const key = document.getElementById('keyResult').textContent;
    if (!key || key === '-') return;

    navigator.clipboard.writeText(key).then(() => {
        alert('✅ Đã copy key!\n\n' + key + '\n\nDùng key này khi chạy tool.');
    }).catch(() => {
        const ta = document.createElement('textarea');
        ta.value = key;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        alert('✅ Đã copy key!');
    });
}

function showMsg(id, text, type = 'ok') {
    const el = document.getElementById(id);
    el.textContent = text;
    el.className = 'msg show ' + type;
}

function escapeHtml(s) {
    if (s === null || s === undefined) return '';
    return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
</script>
</body>
</html>
